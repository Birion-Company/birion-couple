# Desenvolvimento local: o comando `financas` sobe o banco (MariaDB em Docker) e o app sozinho.
# Sem ele: suba um MariaDB/MySQL, copie este arquivo para .env.local e rode `npm run dev`.
# Em produção (Hostinger) a DATABASE_URL usa 127.0.0.1 e o usuário/banco criados no hPanel.
DATABASE_URL=mysql://root:dev@127.0.0.1:33306/couple
# Segredo das sessões. Em produção, defina um valor longo e aleatório no Netlify.
AUTH_SECRET=troque-por-um-valor-longo-e-aleatorio
# Notificações push: gere com `npx web-push generate-vapid-keys` e defina no Netlify.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/Birion-Company/birion-finance
# Segredo da rota que dispara os avisos agendados (fatura fechando/vencendo).
CRON_SECRET=
