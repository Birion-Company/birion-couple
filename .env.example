# Desenvolvimento local (o Netlify define tudo isso sozinho em produção).
# 1) Rode `npm run db:dev` em um terminal.
# 2) Copie este arquivo para .env.local e rode `npm run dev`.
NETLIFY_DB_URL=postgres://postgres@localhost:54329/postgres
NETLIFY_DB_DRIVER=server
# Segredo das sessões. Em produção, defina um valor longo e aleatório no Netlify.
AUTH_SECRET=troque-por-um-valor-longo-e-aleatorio
